{
  "manifest_version": 3,
  "name": "Editorial Quick View",
  "version": "0.1.0",
  "description": "Quickly view the Codeforces editorial for the problem you're solving.",
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/problemset/problem/*/*"],
      "js": [
        "dist/katex/katex.min.js",
        "dist/katex/auto-render.min.js",
        "dist/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/katex/*"],
      "matches": ["https://codeforces.com/*"]
    }
  ]
}
